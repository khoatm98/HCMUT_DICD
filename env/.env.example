# Copy this file to env/.env and edit if you need overrides:
#     cp env/.env.example env/.env
# The top-level Makefile picks up env/.env automatically if it exists.

# Pinned all-in-one EDA image (tools + SKY130 baked in).
EDA_IMAGE=hpretl/iic-osic-tools:2026.05

# noVNC desktop password and host ports.
VNC_PW=hcmut
NOVNC_PORT=8888
VNC_PORT=5901

# ---- Offline classrooms ----
# Point at a local registry mirror so no one pulls from the internet:
# EDA_IMAGE=mirror.campus.local:5000/iic-osic-tools:2026.05

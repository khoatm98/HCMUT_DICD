# ---- Simulation build / run artifacts ----
sim/
**/sim/
*.vvp
*.vcd
*.fst
*.saif
obj_dir/
**/obj_dir/

# NOTE: public golden test patterns under 00_TB/golden/ ARE committed (students
# get the public patterns; the generators are instructor-private). Only RUN
# ARTIFACTS are ignored.

# ---- per-stage build directories (01_RTL/build, 02_SYN/build, ...) ----
**/build/

# ---- Synthesis / STA generated outputs ----
*.netlist.v
*_syn.v
*.rpt

# ---- OpenLane / LibreLane run directories ----
runs/
**/runs/

# ---- APR src/ + macro views are populated by `make prep` (symlinks) ----
hw/hw5-apr/04_APR/src/*.v
hw/hw5-apr/04_APR/src/*.vh
hw/hw5-apr/04_APR/macros/

# ---- Physical layout (regenerable RUN outputs) ----
*.gds
*.def
# ...but VENDORED PDK GDS under pdk/ IS committed (a library deliverable, not a
# run artifact -- e.g. the SRAM macro layout; see pdk/NOTICE).
!pdk/**/*.gds

# ---- Python ----
__pycache__/
*.pyc

# ---- Local environment / secrets ----
env/docker/.env
env/conda/conda-lock.yml

# ---- OS / editor cruft ----
.DS_Store
*.swp
*~

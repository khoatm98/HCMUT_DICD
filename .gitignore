# ---- Simulation build / run artifacts ----
sim/
**/sim/
*.vvp
*.vcd
*.fst
*.saif
obj_dir/
**/obj_dir/

# ---- Generated golden vectors (reproduced deterministically by `make vectors`) ----
**/golden/*.hex
**/golden/*.vh

# ---- Synthesis / STA generated outputs ----
*.netlist.v
*_syn.v
*.rpt

# ---- OpenLane / LibreLane run directories ----
runs/
**/runs/

# ---- HW5 APR src/ is populated from common/rtl by `make prep` (symlinks) ----
hw/hw5-apr/src/*.v
hw/hw5-apr/src/*.vh
final-project/src/*.v
final-project/src/*.vh

# ---- Physical layout (regenerable) ----
*.gds
*.def

# ---- Python ----
__pycache__/
*.pyc

# ---- Local environment / secrets ----
env/docker/.env
env/conda/conda-lock.yml

# ---- OS / editor cruft ----
.DS_Store
*.swp
*~
